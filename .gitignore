# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# pytests results
.pytest_cache/
**/tests/results/

# Eval run folders (exported notebooks, run records, per-run scores) stay out of the repo; each skill keeps
# only its score summaries (eval/baseline_scores.json, eval/with_skill_scores.json) and its report.
skills/*/eval/models/*/runs_*/

# Local agent skill installs (project consumers)
.claude/skills/
.cursor/skills/
.agents/skills/

# Local Isaac tooling state
.isaac/

# Local reference clones
.ref-*/
.ref-tmp/

# Environment / secrets
.env
.env.local
*.pem

# MkDocs build output
site/
